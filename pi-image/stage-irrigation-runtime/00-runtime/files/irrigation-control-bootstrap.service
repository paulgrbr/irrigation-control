[Unit]
Description=Start irrigation-control Docker deployment
# Ensure network and Docker are available before compose bootstrap runs.
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/irrigation-control-bootstrap
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target