#!/bin/bash
set -euo pipefail

compose_dir="/opt/irrigation-control"
compose_file="${compose_dir}/compose.yaml"
compose_url="https://raw.githubusercontent.com/paulgrbr/irrigation-control/main/infrastructure/compose.yaml"
temporary_compose="$(mktemp)"
compose_cmd=()
display_cmd="/usr/local/sbin/irrigation-control-display"
backend_health_url="${BACKEND_HEALTH_URL:-http://127.0.0.1:8080/health}"
backend_timeout_seconds="${BACKEND_READY_TIMEOUT_SECONDS:-300}"
backend_interval_seconds="${BACKEND_READY_INTERVAL_SECONDS:-5}"
download_retry_total="5"
download_retry_delay_seconds="5"
compose_pull_timeout_seconds="${COMPOSE_PULL_TIMEOUT_SECONDS:-600}"
current_step="BOOTING"
compose_candidate=""
compose_source=""
portainer_url="${PORTAINER_URL:-https://127.0.0.1:9443}"
portainer_admin_username="${PORTAINER_ADMIN_USERNAME:-}"
portainer_admin_password="${PORTAINER_ADMIN_PASSWORD:-}"
portainer_init_timeout_seconds="${PORTAINER_INIT_TIMEOUT_SECONDS:-120}"
portainer_init_retry_seconds="${PORTAINER_INIT_RETRY_SECONDS:-3}"
portainer_env_file="/etc/default/irrigation-control-bootstrap"

wait_docker_probe_total="30"
wait_docker_probe_sleep_seconds="2"
wait_pull_progress_sleep_seconds="4"

WAIT_DOCKER_PERCENT_START="10"
WAIT_DOCKER_PERCENT_END="20"
FETCH_COMPOSE_PERCENT="25"
VALIDATE_PERCENT="40"
INSTALL_PERCENT="50"
PULL_PERCENT_START="65"
PULL_PERCENT_END="79"
START_PERCENT="80"
PORTAINER_INIT_PERCENT="85"
WAIT_BACKEND_PERCENT_START="90"
WAIT_BACKEND_PERCENT_END="99"
READY_PERCENT="100"

trap 'rm -f "$temporary_compose"' EXIT

display_update() {
	if [ -x "$display_cmd" ]; then
		"$display_cmd" "$@" || true
	fi
}

fail_with_step() {
	local exit_code="$1"
	display_update --state "ERROR" --percent 100 --detail "$current_step"
	echo "[bootstrap] failed at step: ${current_step}" >&2
	exit "$exit_code"
}

on_error() {
	local exit_code="$?"
	fail_with_step "$exit_code"
}

trap on_error ERR

load_portainer_credentials() {
	if [ -n "$portainer_admin_username" ] && [ -n "$portainer_admin_password" ]; then
		return
	fi

	portainer_admin_username=""
	portainer_admin_password=""
	if [ ! -f "$portainer_env_file" ]; then
		return
	fi

	# File is generated with Bash %q during image creation and is root-only.
	# shellcheck disable=SC1090
	. "$portainer_env_file"
	portainer_admin_username="${PORTAINER_ADMIN_USERNAME:-}"
	portainer_admin_password="${PORTAINER_ADMIN_PASSWORD:-}"
}

set_step() {
	current_step="$1"
	local state="$2"
	local percent="$3"
	local detail="$4"
	display_update --state "$state" --percent "$percent" --detail "$detail"
}

clamp_percent() {
	local value="$1"
	local min_value="$2"
	local max_value="$3"
	if [ "$value" -lt "$min_value" ]; then
		echo "$min_value"
		return
	fi
	if [ "$value" -gt "$max_value" ]; then
		echo "$max_value"
		return
	fi
	echo "$value"
}

wait_for_docker() {
	set_step "WAIT_DOCKER" "WAIT_DOCKER" "$WAIT_DOCKER_PERCENT_START" "Docker wird geprueft"

	for docker_probe in $(seq 1 "$wait_docker_probe_total"); do
		if docker info >/dev/null 2>&1; then
			return
		fi

		docker_percent="$((WAIT_DOCKER_PERCENT_START + (docker_probe * (WAIT_DOCKER_PERCENT_END - WAIT_DOCKER_PERCENT_START) / wait_docker_probe_total)))"
		docker_percent="$(clamp_percent "$docker_percent" "$WAIT_DOCKER_PERCENT_START" "$WAIT_DOCKER_PERCENT_END")"
		display_update \
			--state "WAIT_DOCKER" \
			--percent "$docker_percent" \
			--attempt-current "$docker_probe" \
			--attempt-total "$wait_docker_probe_total"
		sleep "$wait_docker_probe_sleep_seconds"
	done

	echo "[bootstrap] docker daemon is not ready" >&2
	false
}

detect_compose_command() {
	if docker compose version >/dev/null 2>&1; then
		compose_cmd=(docker compose)
		return
	fi

	if command -v docker-compose >/dev/null 2>&1; then
		compose_cmd=(docker-compose)
		return
	fi

	echo "[bootstrap] no docker compose command found (docker compose or docker-compose)" >&2
	false
}

fetch_compose_with_retry() {
	set_step "FETCH_COMPOSE" "FETCH_COMPOSE" "$FETCH_COMPOSE_PERCENT" "Compose Download"

	for download_try in $(seq 1 "$download_retry_total"); do
		display_update \
			--state "FETCH_COMPOSE" \
			--percent "$FETCH_COMPOSE_PERCENT" \
			--detail "Compose Download" \
			--retry-current "$download_try" \
			--retry-total "$download_retry_total"

		if curl --fail --location --silent --show-error --output "$temporary_compose" "$compose_url"; then
			compose_candidate="$temporary_compose"
			compose_source="remote"
			return
		fi

		if [ "$download_try" -eq "$download_retry_total" ]; then
			if [ -f "$compose_file" ]; then
				compose_candidate="$compose_file"
				compose_source="local-cache"
				echo "[bootstrap] compose download failed; using cached local compose: ${compose_file}" >&2
				display_update --state "FETCH_COMPOSE" --percent "$FETCH_COMPOSE_PERCENT" --detail "Nutze lokalen Cache"
				return
			fi

			echo "[bootstrap] compose download failed after ${download_retry_total} attempts and no local cache exists" >&2
			false
		fi

		sleep "$download_retry_delay_seconds"
	done
}

validate_and_install_compose() {
	set_step "VALIDATE_COMPOSE" "VALIDATE" "$VALIDATE_PERCENT" "Datei pruefen"
	"${compose_cmd[@]}" -f "$compose_candidate" config --quiet

	set_step "INSTALL_COMPOSE" "INSTALL" "$INSTALL_PERCENT" "Datei sichern"
	if [ "$compose_source" = "remote" ]; then
		install -m 0644 "$temporary_compose" "$compose_file"
	else
		echo "[bootstrap] keeping cached local compose: ${compose_file}" >&2
		display_update --state "INSTALL" --percent "$INSTALL_PERCENT" --detail "Cache bleibt aktiv"
	fi
}

wait_for_portainer_api() {
	local deadline_seconds="${1:?missing deadline}"
	local status_url="${portainer_url}/api/status"
	local current_time
	current_time="$(date +%s)"
	while [ "$current_time" -lt "$deadline_seconds" ]; do
		if curl --insecure --fail --silent --show-error --max-time 3 "$status_url" >/dev/null; then
			return 0
		fi
		sleep "$portainer_init_retry_seconds"
		current_time="$(date +%s)"
	done

	echo "[bootstrap] portainer api did not become ready: ${status_url}" >&2
	return 1
}

bootstrap_portainer_admin() {
	if [ -z "$portainer_admin_username" ] || [ -z "$portainer_admin_password" ]; then
		echo "[bootstrap] portainer credentials not configured; skipping admin init" >&2
		return 0
	fi

	set_step "PORTAINER_INIT" "PORTAINER_INIT" "$PORTAINER_INIT_PERCENT" "Portainer einrichten"

	local deadline_seconds
	deadline_seconds="$(( $(date +%s) + portainer_init_timeout_seconds ))"
	if ! wait_for_portainer_api "$deadline_seconds"; then
		echo "[bootstrap] continuing without portainer admin initialization" >&2
		return 0
	fi

	local payload response_code response_body
	payload="$(PORTAINER_ADMIN_USERNAME="$portainer_admin_username" PORTAINER_ADMIN_PASSWORD="$portainer_admin_password" python3 - <<'PY'
import json
import os

print(json.dumps({
    "Username": os.environ["PORTAINER_ADMIN_USERNAME"],
    "Password": os.environ["PORTAINER_ADMIN_PASSWORD"],
}))
PY
)"
	response_body="$(mktemp)"
	response_code="$(curl --insecure --silent --show-error --output "$response_body" --write-out '%{http_code}' --request POST "${portainer_url}/api/users/admin/init" --header 'Content-Type: application/json' --data "$payload" || true)"
	case "$response_code" in
		200|201|204|409)
			if [ "$response_code" = "409" ]; then
				echo "[bootstrap] portainer admin already initialized" >&2
			else
				echo "[bootstrap] portainer admin initialized" >&2
			fi
			rm -f "$response_body"
			return 0
			;;
		*)
			echo "[bootstrap] portainer admin init failed with HTTP ${response_code}" >&2
			cat "$response_body" >&2 || true
			rm -f "$response_body"
			echo "[bootstrap] continuing without portainer admin initialization" >&2
			return 0
			;;
	esac
}

pull_images_with_progress() {
	local pull_percent="$PULL_PERCENT_START"
	local pull_started_at
	set_step "PULL_IMAGES" "PULL_IMAGES" "$pull_percent" "Images werden geladen"

	"${compose_cmd[@]}" -f "$compose_file" pull &
	local pull_pid="$!"
	pull_started_at="$(date +%s)"
	while kill -0 "$pull_pid" 2>/dev/null; do
		local pull_elapsed
		pull_elapsed="$(( $(date +%s) - pull_started_at ))"
		if [ "$pull_elapsed" -ge "$compose_pull_timeout_seconds" ]; then
			echo "[bootstrap] image pull timed out after ${compose_pull_timeout_seconds}s; using locally cached images" >&2
			kill "$pull_pid" 2>/dev/null || true
			wait "$pull_pid" || true
			display_update --state "PULL_IMAGES" --percent "$PULL_PERCENT_END" --detail "Nutze lokale Images"
			return
		fi

		if [ "$pull_percent" -lt "$PULL_PERCENT_END" ]; then
			pull_percent="$((pull_percent + 1))"
		fi
		display_update --state "PULL_IMAGES" --percent "$pull_percent" --detail "Images werden geladen"
		sleep "$wait_pull_progress_sleep_seconds"
	done
	if ! wait "$pull_pid"; then
		echo "[bootstrap] image pull failed; continuing with locally cached images" >&2
		display_update --state "PULL_IMAGES" --percent "$PULL_PERCENT_END" --detail "Nutze lokale Images"
	fi
}

start_compose_stack() {
	set_step "START_CONTAINERS" "START" "$START_PERCENT" "Container starten"
	"${compose_cmd[@]}" -f "$compose_file" up -d --remove-orphans
}

wait_for_backend_ready() {
	set_step "WAIT_BACKEND" "WAIT_BACKEND" "$WAIT_BACKEND_PERCENT_START" "Backend health"

	local backend_start_time
	backend_start_time="$(date +%s)"
	while true; do
		if curl --fail --silent --show-error --max-time 3 "$backend_health_url" >/dev/null; then
			return
		fi

		local backend_now backend_elapsed backend_remaining backend_percent
		backend_now="$(date +%s)"
		backend_elapsed="$((backend_now - backend_start_time))"
		if [ "$backend_elapsed" -ge "$backend_timeout_seconds" ]; then
			echo "[bootstrap] backend readiness timed out after ${backend_timeout_seconds}s: ${backend_health_url}" >&2
			false
		fi

		backend_remaining="$((backend_timeout_seconds - backend_elapsed))"
		backend_percent="$((WAIT_BACKEND_PERCENT_START + (backend_elapsed * (WAIT_BACKEND_PERCENT_END - WAIT_BACKEND_PERCENT_START) / backend_timeout_seconds)))"
		backend_percent="$(clamp_percent "$backend_percent" "$WAIT_BACKEND_PERCENT_START" "$WAIT_BACKEND_PERCENT_END")"
		display_update \
			--state "WAIT_BACKEND" \
			--percent "$backend_percent" \
			--seconds-left "$backend_remaining"
		sleep "$backend_interval_seconds"
	done
}

mark_ready() {
	set_step "READY" "READY" "$READY_PERCENT" "Backend ist bereit"
}

set_step "BOOTING" "BOOTING" "5" "System wird vorbereitet"

install -d -m 0755 "$compose_dir"
load_portainer_credentials
wait_for_docker
detect_compose_command
fetch_compose_with_retry
validate_and_install_compose
pull_images_with_progress
start_compose_stack
bootstrap_portainer_admin
wait_for_backend_ready
mark_ready