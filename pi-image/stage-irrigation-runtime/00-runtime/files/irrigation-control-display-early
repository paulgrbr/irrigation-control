#!/bin/bash
set -euo pipefail

display_cmd="/usr/local/sbin/irrigation-control-display"
i2c_device="/dev/i2c-${LCD_I2C_BUS:-1}"

if [ ! -x "$display_cmd" ]; then
	exit 0
fi

for attempt in {1..25}; do
	if [ -e "$i2c_device" ] \
		&& "$display_cmd" --state "BOOTING" --percent 1 --detail "System startet"; then
		exit 0
	fi
	sleep 0.2
done

echo "[display-early] LCD unavailable: ${i2c_device}" >&2
exit 0